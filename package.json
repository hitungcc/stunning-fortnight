{
  "name": "stunning-fortnight",
  "version": "1.0.0",
  "description": "Steam game idler service — runs 24/7 via PM2, supports 2FA (Steam Guard Mobile Authenticator & email code)",
  "main": "src/idler.js",
  "type": "module",
  "scripts": {
    "start": "node src/idler.js",
    "dev": "node --watch src/idler.js",
    "bootstrap": "node scripts/bootstrap.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop steam-idler",
    "pm2:restart": "pm2 restart steam-idler",
    "pm2:logs": "pm2 logs steam-idler",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "steam",
    "idler",
    "playtime",
    "trading-cards",
    "pm2",
    "termux"
  ],
  "license": "MIT",
  "author": "vermilion10",
  "repository": "https://github.com/hitungcc/stunning-fortnight"
}
