{
  "name": "stunning-fortnight",
  "version": "2.0.0",
  "description": "Steam game idler — runs 24/7 in a tmux session, rotates games round-robin, supports 2FA (Steam Guard Mobile Authenticator & email code)",
  "main": "src/idler.js",
  "type": "module",
  "scripts": {
    "start": "node src/idler.js",
    "dev": "node --watch src/idler.js",
    "bootstrap": "node scripts/bootstrap.js",
    "tmux:start": "sh scripts/tmux-start.sh",
    "tmux:attach": "tmux attach -t steam-idler",
    "tmux:stop": "tmux kill-session -t steam-idler",
    "ach:probe": "node scripts/ach-probe.js",
    "ach:plan": "node scripts/ach-plan.js",
    "ach:unlock": "node scripts/ach-unlock-once.js",
    "test": "node --test"
  },
  "dependencies": {
    "binarykvparser": "^2.3.0",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "steam",
    "idler",
    "playtime",
    "trading-cards",
    "tmux",
    "termux"
  ],
  "license": "MIT",
  "author": "vermilion10",
  "repository": "https://github.com/hitungcc/stunning-fortnight"
}
