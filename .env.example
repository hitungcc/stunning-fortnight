# ╔══════════════════════════════════════════════════════════════╗
# ║              STUNNING-FORTNIGHT • STEAM IDLER               ║
# ║            Environment Configuration Template                ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control!

# ──────────────────────────────────────────────────────────────
# STEAM CREDENTIALS
# ──────────────────────────────────────────────────────────────
STEAM_USERNAME=your_steam_username
STEAM_PASSWORD=your_steam_password

# ──────────────────────────────────────────────────────────────
# STEAM GUARD / 2FA CONFIGURATION
# ──────────────────────────────────────────────────────────────
# If you use Steam Guard Mobile Authenticator, set your shared_secret
# here so the idler can generate 2FA codes automatically.
#
# How to get your shared_secret:
#   - Android: Use apps like "Steam Desktop Authenticator" (SDA) 
#     or extract from rooted device at
#     /data/data/com.valvesoftware.android.steam.community/files/Steamguard-<steamid>
#   - iOS: Use SDA or similar tool to migrate your authenticator
#   - SDA: After importing, find it in maFiles/<steamid>.maFile (JSON)
#
# If left empty, the idler will prompt you for the code on startup
# (not ideal for 24/7 unattended operation).
STEAM_SHARED_SECRET=

# Identity secret (optional — needed only for trade confirmations)
STEAM_IDENTITY_SECRET=

# ──────────────────────────────────────────────────────────────
# GAME IDS TO IDLE
# ──────────────────────────────────────────────────────────────
# Comma-separated list of Steam App IDs to idle simultaneously.
# You can idle up to ~32 games at once (Steam's limit).
#
# Find App IDs on: https://store.steampowered.com
# (the number in the URL, e.g. Half-Life 2 = 220)
#
# Examples:
#   STEAM_GAME_IDS=730,440,570          (CS2, TF2, Dota 2)
#   STEAM_GAME_IDS=220                  (Half-Life 2 only)
STEAM_GAME_IDS=730,440,570

# ──────────────────────────────────────────────────────────────
# DEVICE NAME (visible in Steam login devices / authorized computers)
# ──────────────────────────────────────────────────────────────
# Set a recognizable name so you know which device is the idler
# when checking Steam → Settings → Security → Manage Devices.
# Default: "stunning-fortnight"
STEAM_MACHINE_NAME=stunning-fortnight

# ──────────────────────────────────────────────────────────────
# IDLER BEHAVIOR
# ──────────────────────────────────────────────────────────────
# Online status while idling:
#   0 = Offline (invisible — recommended, least attention)
#   1 = Online
#   2 = Busy
#   3 = Away
#   4 = Snooze
#   5 = Looking to trade
#   6 = Looking to play
STEAM_PERSONA_STATE=0

# Heartbeat interval in minutes (status log every N minutes)
HEARTBEAT_INTERVAL=30

# Auto-reconnect delay in seconds after disconnect
RECONNECT_DELAY=30

# Maximum reconnect attempts before giving up (0 = infinite)
MAX_RECONNECT_ATTEMPTS=0
