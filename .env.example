# ╔══════════════════════════════════════════════════════════════╗
# ║              STUNNING-FORTNIGHT • STEAM IDLER               ║
# ║            Environment Configuration Template                ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control!

# ──────────────────────────────────────────────────────────────
# STEAM CREDENTIALS
# ──────────────────────────────────────────────────────────────
STEAM_USERNAME=your_steam_username
STEAM_PASSWORD=your_steam_password

# ──────────────────────────────────────────────────────────────
# STEAM GUARD / 2FA CONFIGURATION
# ──────────────────────────────────────────────────────────────
# If you use Steam Guard Mobile Authenticator, set your shared_secret
# here so the idler can generate 2FA codes automatically.
#
# How to get your shared_secret:
#   - Android: Use apps like "Steam Desktop Authenticator" (SDA) 
#     or extract from rooted device at
#     /data/data/com.valvesoftware.android.steam.community/files/Steamguard-<steamid>
#   - iOS: Use SDA or similar tool to migrate your authenticator
#   - SDA: After importing, find it in maFiles/<steamid>.maFile (JSON)
#
# If left empty, the idler will prompt you for the code on startup
# (not ideal for 24/7 unattended operation).
STEAM_SHARED_SECRET=

# Identity secret (optional — needed only for trade confirmations)
STEAM_IDENTITY_SECRET=

# ──────────────────────────────────────────────────────────────
# GAME IDS TO IDLE
# ──────────────────────────────────────────────────────────────
# Comma-separated list of Steam App IDs to idle simultaneously.
# You can idle up to ~32 games at once (Steam's limit).
#
# Find App IDs on: https://store.steampowered.com
# (the number in the URL, e.g. Half-Life 2 = 220)
#
# Examples:
#   STEAM_GAME_IDS=730,440,570          (CS2, TF2, Dota 2)
#   STEAM_GAME_IDS=220                  (Half-Life 2 only)
STEAM_GAME_IDS=730,440,570

# ──────────────────────────────────────────────────────────────
# DEVICE NAME (visible in Steam login devices / authorized computers)
# ──────────────────────────────────────────────────────────────
# Set a recognizable name so you know which device is the idler
# when checking Steam → Settings → Security → Manage Devices.
# Default: "stunning-fortnight"
STEAM_MACHINE_NAME=stunning-fortnight

# ──────────────────────────────────────────────────────────────
# IDLE MODE
# ──────────────────────────────────────────────────────────────
# The four modes differ only in how STEAM_GAME_IDS is split between
# games that are ALWAYS idling and games that TAKE TURNS:
#
#   all         Every game idles together. Nothing rotates.
#               Simple, but every game ends up with an identical
#               playtime — the obvious "this is a bot" signature.
#
#   continuous  A fixed set (IDLE_PINNED) idles forever.
#               Everything else in STEAM_GAME_IDS is never played.
#               Use when you want to farm one or two specific games.
#
#   hybrid      A fixed set (IDLE_PINNED) idles forever, AND the
#               remaining games rotate through the leftover slots.
#               One priority title always accruing, the rest sharing.
#
#   rotate      Nothing is pinned — every game takes turns.
#               Full round-robin: each slot the least-idled games are
#               promoted, so playtime spreads evenly across the library.
#
IDLE_MODE=rotate

# How many games are idling at any one moment (TOTAL, pinned included).
#   all         ignored — every game idles
#   continuous  how many games to pin when IDLE_PINNED is empty
#   hybrid      pinned games + this many free slots... i.e. free slots
#               = IDLE_BATCH_SIZE - (number of pinned games), min 1
#   rotate      how many games rotate at a time
IDLE_BATCH_SIZE=1

# App IDs that are ALWAYS idling — used by "continuous" and "hybrid".
# Ignored by "all" and "rotate". If left empty, the idler pins the first
# game(s) from STEAM_GAME_IDS and tells you which ones it picked.
# Example:  IDLE_PINNED=730
IDLE_PINNED=

# Minutes each rotation slot lasts before switching (hybrid / rotate).
# Steam credits playtime in ~30 min chunks, so 30+ is a sensible floor.
IDLE_INTERVAL=30

# Randomise the slot length by ±N% (0 = exact intervals).
# Keeps totals from landing on suspiciously round, identical numbers.
IDLE_JITTER=15

# Where per-game accumulated idle time is stored. Persisted across
# restarts so the queue resumes instead of resetting.
IDLE_STATE_FILE=./data/idle-state.json

# ──────────────────────────────────────────────────────────────
# ACHIEVEMENTS
# ──────────────────────────────────────────────────────────────
# Unlocks each game's achievements gradually, paced by how long that
# game has actually idled. Only games that are idling right now make
# progress, so rotation and disconnects stretch the schedule naturally.
#
# This writes to your Steam account. It starts in dry-run mode, which
# only logs what it would unlock; set ACH_DRY_RUN=false to go live.
ACH_ENABLED=false
ACH_DRY_RUN=true

# Pace: average idle hours per achievement, with the per-game total
# kept between ACH_MIN_HOURS and ACH_MAX_HOURS, then varied by ±ACH_JITTER%.
#   e.g. 29 achievements × 3h = 87h;  500 achievements → capped at 150h
ACH_HOURS_EACH=3
ACH_MIN_HOURS=10
ACH_MAX_HOURS=150
ACH_JITTER=20

# rarity  common achievements first, rare ones last (uses global unlock %)
# random  any order
ACH_ORDER=rarity

# Percentage of each game's achievements to end at. A range such as
# 80-95 picks a random target per game and leaves the rarest locked.
ACH_COMPLETION=100

# Chance (0–1) that an unlock follows the previous one within minutes.
ACH_BURST=0.1

# Unlock achievements tied to an in-game stat ("earn 1,000,000 money"),
# raising that stat to the required value at the same time. false skips them.
ACH_STAT_LINKED=true

# No unlocks during these local hours (idle time still counts).
# Format HH-HH, wraps past midnight (22-06). Set to "off" to disable.
ACH_QUIET_HOURS=02-08

# Minutes a game must have been idling in the current session before
# it can unlock anything.
ACH_WARMUP=15

# Achievement API names never to unlock, and App IDs to leave alone
# entirely (comma-separated). Protected achievements are always skipped.
ACH_EXCLUDE=
ACH_SKIP_GAMES=

# Where each game's unlock plan and progress are stored.
ACH_STATE_FILE=./data/achievement-state.json

# ──────────────────────────────────────────────────────────────
# IDLER BEHAVIOR
# ──────────────────────────────────────────────────────────────
# Online status while idling:
#   0 = Offline (invisible — recommended, least attention)
#   1 = Online
#   2 = Busy
#   3 = Away
#   4 = Snooze
#   5 = Looking to trade
#   6 = Looking to play
STEAM_PERSONA_STATE=0

# Heartbeat interval in minutes (status log every N minutes)
HEARTBEAT_INTERVAL=30

# Auto-reconnect delay in seconds after disconnect
RECONNECT_DELAY=30

# Maximum reconnect attempts before giving up (0 = infinite)
MAX_RECONNECT_ATTEMPTS=0
